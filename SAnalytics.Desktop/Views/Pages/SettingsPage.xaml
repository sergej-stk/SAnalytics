<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SAnalytics.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAnalytics.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="MainNavigationView" IsSettingsVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="Dashboard"
                Icon="Home"
                Tag="Dashboard" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                Content="Abmelden"
                Icon="ContactInfo"
                Tag="Logout" />
        </NavigationView.FooterMenuItems>

        <NavigationView.Content>
            <ScrollViewer>
                <StackPanel Margin="40" Spacing="24">
                    <!-- Header -->
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Margin="0,0,0,16" />

                    <!-- Language Section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <controls:LanguageSelector />
                        </Border>
                    </StackPanel>

                    <!-- Other Settings Section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.AdditionalSettingsLabel, Mode=OneWay}"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="16">
                                <!-- Placeholder for future settings -->
                                <TextBlock 
                                    Text="{x:Bind ViewModel.AdditionalOptionsLabel, Mode=OneWay}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView.Content>
    </NavigationView>
</Page>